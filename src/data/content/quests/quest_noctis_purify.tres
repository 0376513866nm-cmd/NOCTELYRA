[resource]
script = ExtResource("1")
quest_id = "quest_noctis_purify"
title = "Ánh Sáng Bị Nuốt Chửng"
description = "Ma lực tại Rừng Hắc Nguyệt đang mất cân bằng. Hãy tiêu diệt 3 sinh vật bị ma lực tha hóa để bảo vệ ngôi làng."
giver_name = "Eiran"
giver_location = "Rừng Hắc Nguyệt"
is_main_quest = true
quest_type = 0
target_id = "corrupted_wolf"
target_amount = 3
reward_gold = 50
reward_exp = 50
reward_items = []
restore_health_on_complete = true
restore_mana_on_complete = true
offer_dialogue = ["Mừng con đã trở về Tổ Ấm Đèn Nguyệt. Đêm nay gió rừng có chút xao động...", "Ma lực sâu trong Rừng Hắc Nguyệt đang hỗn loạn bất thường, khiến các sinh vật hoang dã bị tha hóa.", "Uống một ngụm trà thảo mộc ấm rồi tiến vào rừng tiêu diệt {target} sinh vật bị ma hóa giúp ta được không?"]
active_dialogue = ["Hãy cẩn trọng khi bước qua ranh giới Rừng Hắc Nguyệt nhé.", "Tiến độ hiện tại: {progress}/{target} sinh vật ma hóa. Mau hoàn thành rồi về sưởi ấm cạnh bếp lửa nhé!"]
ready_dialogue = ["Con đã trở về an toàn rồi! Mầm và Lumi cứ ngóng con mãi ngoài hiên đấy.", "Ma khí quanh bìa rừng đã lắng dịu. Hãy nhận 50 Vàng và để ta dùng quang ma pháp thanh tẩy, hồi phục trọn vẹn sinh lực cho con!"]
inventory_full_dialogue = ["Túi đồ của ngươi hiện đã đầy!", "Hãy dọn chỗ trống trong túi đồ trước khi nhận thưởng nhé."]
completed_dialogue = ["Cảm ơn con đã bảo vệ sự bình yên của Tổ Ấm Đèn Nguyệt.", "Mỗi khi mỏi mệt, con luôn có thể trở về đây ngồi bên bếp lửa để nghỉ ngơi và hồi phục.", "Hãy tiếp tục rèn luyện kỹ năng kiếm thuật (J) và ma pháp (K) để sẵn sàng cho những thử thách lớn hơn phía trước!"]
