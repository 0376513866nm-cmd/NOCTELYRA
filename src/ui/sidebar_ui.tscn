[node name="GuideCombatText" type="Label" parent="MainVBox/ContentContainer/SettingsPanel/VBox/GuideContent/Margin/GuideVBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "• A / D hoặc ← / → : Di chuyển trái / phải
• Space : Nhảy / Nhảy đôi trên không
• Shift / X : Lướt nhanh né đòn (Dash)
• J : Đánh thường cận chiến (Slash)
• K : Tung ma pháp (Tiêu hao MP)
• 1, 2, 3 / Cuộn chuột : Đổi loại ma pháp
• U : Nâng cấp kỹ năng đang chọn"

[node name="HSeparatorGuide" type="HSeparator" parent="MainVBox/ContentContainer/SettingsPanel/VBox/GuideContent/Margin/GuideVBox"]
layout_mode = 2

[node name="GuideSystemTitle" type="Label" parent="MainVBox/ContentContainer/SettingsPanel/VBox/GuideContent/Margin/GuideVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.85, 1, 1)
theme_override_font_sizes/font_size = 12
text = "🧭 HỆ THỐNG & GIAO DIỆN:"

[node name="GuideSystemText" type="Label" parent="MainVBox/ContentContainer/SettingsPanel/VBox/GuideContent/Margin/GuideVBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "• E : Tương tác NPC / Cổng / Mở hòm
• F1 : Bật / Tắt phím ảo cảm ứng (Hybrid)
• F3 : Bật / Tắt đo FPS
• I : Mở Túi Đồ & Trang Bị
• Q : Mở Sổ Nhiệm Vụ
• C : Mở Bảng Thông Tin Nhân Vật
• L : Chuyển đổi Ngày / Đêm
• Tab / M : Ẩn / Hiện Bảng Điều Khiển
• Esc : Tạm dừng game"

