[node name="ControlsGuideText" type="Label" parent="Sidebar/MainVBox/ContentContainer/SettingsPanel"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
autowrap_mode = 2
text = "• A / D hoặc ← / → : Di chuyển trái / phải
• Space : Nhảy / Nhảy đôi trên không
• Shift : Lướt nhanh né đòn (Dash)
• J : Đánh thường cận chiến (Slash)
• K : Dùng ma pháp (Tiêu hao MP)
• 1, 2, 3 : Chuyển đổi loại ma pháp
• U : Nâng cấp kỹ năng đang chọn
• E : Tương tác với NPC (Elyra) / Cổng
• Tab / M : Ẩn / Hiện Bảng Điều Khiển
• Esc : Tạm dừng game"

